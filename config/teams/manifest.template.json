{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "0.1.0",
  "id": "${TEAMS_APP_ID}",
  "packageName": "com.example.decisionnavigator.mvp",
  "developer": {
    "name": "${PUBLISHER_NAME}",
    "websiteUrl": "${PUBLISHER_WEBSITE_URL}",
    "privacyUrl": "${PRIVACY_URL}",
    "termsOfUseUrl": "${TERMS_URL}"
  },
  "name": {"short": "Decision Navigator", "full": "Decision Navigator – From Discussion to Execution"},
  "description": {
    "short": "Prepare decisions; humans decide and approve.",
    "full": "A bounded bilingual decision-preparation agent with deterministic workflows and mock-only execution in the MVP."
  },
  "icons": {"outline": "outline.png", "color": "color.png"},
  "accentColor": "#0F6CBD",
  "bots": [
    {
      "botId": "${COPILOT_STUDIO_BOT_APP_ID}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "validDomains": ["${COPILOT_STUDIO_DOMAIN}", "${API_DOMAIN}"],
  "webApplicationInfo": {"id": "${ENTRA_APP_ID}", "resource": "api://${API_DOMAIN}/${ENTRA_APP_ID}"},
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {"name": "ChannelMessage.Read.Group", "type": "Application"}
      ]
    }
  }
}
