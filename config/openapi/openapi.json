  "components": {
    "schemas": {
      "ActionCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "title": "Owner Id"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "target_connector": {
            "type": "string",
            "const": "mock",
            "title": "Target Connector",
            "default": "mock"
          },
          "operation": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Operation"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "title",
          "owner_id",
          "operation",
          "payload"
        ],
        "title": "ActionCreate"
      },
      "ApprovalAction": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "payload_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Payload Hash"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "payload_hash"
        ],
        "title": "ApprovalAction"
      },
      "ApprovalRequest": {
        "properties": {
          "target_type": {
            "type": "string",
            "enum": [
              "decision",
              "action"
            ],
            "title": "Target Type"
          },
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "required_approver_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Approver Ids"
          }
        },
        "type": "object",
        "required": [
          "target_type",
          "target_id",
          "payload"
        ],
        "title": "ApprovalRequest"
      },
      "ClassificationInput": {
        "properties": {
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Impact"
          },
          "reversibility": {
            "type": "string",
            "enum": [
              "reversible",
              "partially_reversible",
              "irreversible"
            ],
            "title": "Reversibility"
          },
          "data_classification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted",
              "special_personal"
            ],
            "title": "Data Classification",
            "default": "internal"
          },
          "regulated_or_gxp": {
            "type": "boolean",
            "title": "Regulated Or Gxp",
            "default": false
          },
          "safety_critical": {
            "type": "boolean",
            "title": "Safety Critical",
            "default": false
          },
          "legal_or_hr_decision": {
            "type": "boolean",
            "title": "Legal Or Hr Decision",
            "default": false
          },
          "external_side_effects": {
            "type": "boolean",
            "title": "External Side Effects",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "impact",
          "reversibility"
        ],
        "title": "ClassificationInput"
      },
      "Criterion": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "weight": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Weight"
          },
          "scale": {
            "type": "string",
            "enum": [
              "qualitative",
              "0-5",
              "0-100"
            ],
            "title": "Scale",
            "default": "0-5"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "weight"
        ],
        "title": "Criterion"
      },
      "CriterionValue": {
        "properties": {
          "criterion_id": {
            "type": "string",
            "title": "Criterion Id"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "title": "Value"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Rationale"
          }
        },
        "type": "object",
        "required": [
          "criterion_id",
          "value",
          "rationale"
        ],
        "title": "CriterionValue"
      },
      "DecisionCreate": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "de"
            ],
            "title": "Language",
