{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifactStatus": "PROPOSED_NOT_APPLIED",
  "siteUrl": "${SHAREPOINT_SITE_URL}",
  "version": "1.0",
  "relationships": [
    "DN_Evidence.DecisionId -> DN_Decisions.DecisionId",
    "DN_Actions.DecisionId -> DN_Decisions.DecisionId",
    "DN_Approvals.DecisionId -> DN_Decisions.DecisionId",
    "DN_Audit.DecisionId -> DN_Decisions.DecisionId",
    "DN_Approvals.TargetId -> decision or action immutable identifier"
  ],
  "lists": [
    {
      "name": "DN_Decisions",
      "titleField": "Title",
      "retentionLabel": "${DECISION_RETENTION_LABEL}",
      "versioning": {"enabled": true, "majorVersions": 500},
      "permissions": {"inherit": false, "groups": {"Owners": "Edit", "Contributors": "Contribute", "Approvers": "Read", "Auditors": "Read"}},
      "columns": [
        {"name": "DecisionId", "type": "Text", "required": true, "unique": true, "indexed": true, "maxLength": 80, "updates": "never"},
        {"name": "SchemaVersion", "type": "Text", "required": true, "default": "1.0", "updates": "migration-only"},
        {"name": "RecordVersion", "type": "Number", "required": true, "min": 1, "updates": "workflow-only"},
        {"name": "Language", "type": "Choice", "required": true, "choices": ["en", "de"]},
        {"name": "Title", "type": "Text", "required": true, "maxLength": 200},
        {"name": "DecisionQuestion", "type": "Note", "required": true, "plainText": true},
        {"name": "ProblemStatement", "type": "Note", "requiredForState": "Ready for Decision", "plainText": true},
        {"name": "DesiredOutcome", "type": "Note", "requiredForState": "Ready for Decision", "plainText": true},
        {"name": "ScopeInJson", "type": "Note", "required": false, "format": "JSON array<string>"},
        {"name": "ScopeOutJson", "type": "Note", "required": false, "format": "JSON array<string>"},
        {"name": "SuccessCriteriaJson", "type": "Note", "requiredForState": "Ready for Decision", "format": "JSON array<string>"},
        {"name": "TargetDate", "type": "DateTime", "requiredForState": "Ready for Decision", "dateOnly": true},
        {"name": "RequestedById", "type": "Text", "required": true, "updates": "never"},
        {"name": "DecisionOwnerId", "type": "Text", "requiredForState": "In Evaluation"},
        {"name": "ContributorIdsJson", "type": "Note", "format": "JSON array<string>"},
        {"name": "ApproverIdsJson", "type": "Note", "format": "JSON array<string>"},
        {"name": "StakeholderIdsJson", "type": "Note", "requiredForState": "Ready for Decision", "format": "JSON array<string>"},
        {"name": "ClassificationInputJson", "type": "Note", "required": true, "format": "ClassificationInput JSON"},
        {"name": "PilotClass", "type": "Choice", "required": true, "choices": ["A", "B", "C"], "updates": "workflow-only"},
        {"name": "State", "type": "Choice", "required": true, "indexed": true, "choices": ["Draft", "In Evaluation", "Ready for Decision", "Decided", "In Execution", "Closed", "Blocked"], "updates": "workflow-only"},
        {"name": "BlockedFromState", "type": "Choice", "required": false, "choices": ["Draft", "In Evaluation", "Ready for Decision", "Decided", "In Execution"]},
        {"name": "BlockedReasonsJson", "type": "Note", "format": "JSON array<string>", "updates": "workflow-only"},
        {"name": "CriteriaJson", "type": "Note", "format": "JSON array<Criterion>"},
        {"name": "OptionsJson", "type": "Note", "format": "JSON array<Option>"},
        {"name": "RecommendationOptionId", "type": "Text", "requiredForState": "Ready for Decision"},
        {"name": "RecommendationRationale", "type": "Note", "plainText": true},
        {"name": "UnresolvedQuestionsJson", "type": "Note", "format": "JSON array<string>"},
        {"name": "RisksAssessed", "type": "Boolean", "default": false},
        {"name": "SelectedOptionId", "type": "Text", "requiredForState": "Decided", "updates": "approval-flow-only"},
        {"name": "DecisionText", "type": "Note", "requiredForState": "Decided", "updates": "approval-flow-only"},
        {"name": "ConditionsJson", "type": "Note", "format": "JSON array<string>", "updates": "approval-flow-only"},
        {"name": "DecidedAt", "type": "DateTime", "updates": "approval-flow-only"},
        {"name": "ClosedAt", "type": "DateTime", "updates": "workflow-only"}
      ],
      "validation": "State changes only through deterministic flow; Class C must be Blocked; Class B requires a separate approver; optimistic concurrency uses RecordVersion."
    },
    {
      "name": "DN_Evidence",
      "titleField": "Claim",
      "retentionLabel": "${EVIDENCE_RETENTION_LABEL}",
      "versioning": {"enabled": true, "majorVersions": 500},
      "permissions": {"inherit": false, "groups": {"Owners": "Edit", "Contributors": "Contribute", "Approvers": "Read", "Auditors": "Read"}},
      "columns": [
        {"name": "EvidenceId", "type": "Text", "required": true, "unique": true, "indexed": true, "updates": "never"},
        {"name": "DecisionId", "type": "Text", "required": true, "indexed": true, "updates": "never"},
        {"name": "OptionIdsJson", "type": "Note", "format": "JSON array<string>"},
        {"name": "Claim", "type": "Note", "required": true, "plainText": true, "updates": "never; supersede instead"},
        {"name": "SourceTitle", "type": "Text", "required": true, "maxLength": 500, "updates": "never; supersede instead"},
        {"name": "SourceUrl", "type": "Hyperlink", "required": true, "updates": "never; supersede instead"},
        {"name": "SourceLocator", "type": "Text", "required": true, "maxLength": 500, "updates": "never; supersede instead"},
        {"name": "Excerpt", "type": "Note", "required": true, "plainText": true, "updates": "never; supersede instead"},
        {"name": "CapturedById", "type": "Text", "required": true, "updates": "never"},
        {"name": "CapturedAt", "type": "DateTime", "required": true, "updates": "never"},
        {"name": "Status", "type": "Choice", "required": true, "choices": ["unverified", "verified", "conflicting", "superseded"], "updates": "verifier-or-workflow"},
        {"name": "VerifiedById", "type": "Text", "updates": "verifier-or-workflow"},
        {"name": "VerifiedAt", "type": "DateTime", "updates": "verifier-or-workflow"},
        {"name": "SupersedesEvidenceId", "type": "Text", "updates": "never"},
        {"name": "ContentHash", "type": "Text", "required": true, "maxLength": 64, "updates": "never"}
      ],
      "validation": "Core evidence content is immutable; correction creates a new record that supersedes the prior record; conflicting evidence blocks readiness."
    },
    {
      "name": "DN_Actions",
      "titleField": "Title",
      "retentionLabel": "${ACTION_RETENTION_LABEL}",
      "versioning": {"enabled": true, "majorVersions": 500},
      "permissions": {"inherit": false, "groups": {"Owners": "Edit", "Contributors": "Contribute", "Executors": "Read", "Auditors": "Read"}},
      "columns": [
        {"name": "ActionId", "type": "Text", "required": true, "unique": true, "indexed": true, "updates": "never"},
        {"name": "DecisionId", "type": "Text", "required": true, "indexed": true, "updates": "never"},
        {"name": "Title", "type": "Text", "required": true, "maxLength": 300},
        {"name": "OwnerId", "type": "Text", "required": true},
        {"name": "DueDate", "type": "DateTime", "dateOnly": true},
        {"name": "TargetConnector", "type": "Choice", "required": true, "choices": ["mock"], "updates": "never after approval requested"},
        {"name": "Operation", "type": "Text", "required": true, "maxLength": 120, "updates": "never after approval requested"},
        {"name": "PayloadJson", "type": "Note", "required": true, "format": "canonical JSON object", "updates": "never after approval requested"},
        {"name": "PayloadHash", "type": "Text", "required": true, "maxLength": 64, "updates": "workflow-only"},
        {"name": "Status", "type": "Choice", "required": true, "indexed": true, "choices": ["Proposed", "PendingApproval", "Approved", "Mocked", "Failed", "Cancelled"], "updates": "workflow-only"},
        {"name": "ApprovalId", "type": "Text", "updates": "workflow-only"},
        {"name": "IdempotencyKey", "type": "Text", "unique": true, "updates": "execution-flow-only"},
        {"name": "ResultJson", "type": "Note", "format": "JSON object", "updates": "execution-flow-only"},
        {"name": "CreatedById", "type": "Text", "required": true, "updates": "never"}
      ],
      "validation": "Execution requires Approved status, matching payload hash, permitted Executor, and unused idempotency key. MVP TargetConnector is mock only."
    },
    {
      "name": "DN_Approvals",
      "titleField": "ApprovalId",
      "retentionLabel": "${APPROVAL_RETENTION_LABEL}",
      "versioning": {"enabled": true, "majorVersions": 500},
      "permissions": {"inherit": false, "groups": {"Owners": "Read", "Approvers": "Edit", "Auditors": "Read"}},
      "columns": [
        {"name": "ApprovalId", "type": "Text", "required": true, "unique": true, "indexed": true, "updates": "never"},
        {"name": "DecisionId", "type": "Text", "required": true, "indexed": true, "updates": "never"},
        {"name": "TargetType", "type": "Choice", "required": true, "choices": ["decision", "action"], "updates": "never"},
        {"name": "TargetId", "type": "Text", "required": true, "indexed": true, "updates": "never"},
        {"name": "PayloadJson", "type": "Note", "required": true, "format": "canonical JSON object", "updates": "never"},
        {"name": "PayloadHash", "type": "Text", "required": true, "maxLength": 64, "updates": "never"},
        {"name": "Status", "type": "Choice", "required": true, "choices": ["Pending", "Approved", "Rejected", "Expired", "Revoked"], "updates": "approval-flow-only; terminal cannot change"},
        {"name": "RequestedById", "type": "Text", "required": true, "updates": "never"},
        {"name": "RequiredApproverIdsJson", "type": "Note", "required": true, "format": "JSON array<string>", "updates": "never"},
        {"name": "ActedById", "type": "Text", "updates": "approval-flow-only"},
        {"name": "ActedAt", "type": "DateTime", "updates": "approval-flow-only"},
        {"name": "Comment", "type": "Note", "plainText": true, "updates": "approval-flow-only"}
      ],
      "validation": "Approval applies only to PayloadHash; terminal approvals are immutable; Class B enforces owner/approver separation."
    },
    {
      "name": "DN_Audit",
      "titleField": "AuditId",
      "retentionLabel": "${AUDIT_RETENTION_LABEL}",
      "versioning": {"enabled": false},
      "permissions": {"inherit": false, "groups": {"ServiceAccount": "AddOnly", "Auditors": "Read"}},
      "columns": [
        {"name": "AuditId", "type": "Text", "required": true, "unique": true, "indexed": true, "updates": "never"},
        {"name": "DecisionId", "type": "Text", "required": true, "indexed": true, "updates": "never"},
        {"name": "RecordType", "type": "Choice", "required": true, "choices": ["decision", "evidence", "action", "approval", "system"], "updates": "never"},
        {"name": "RecordId", "type": "Text", "required": true, "indexed": true, "updates": "never"},
        {"name": "EventType", "type": "Text", "required": true, "maxLength": 160, "updates": "never"},
        {"name": "ActorId", "type": "Text", "required": true, "updates": "never"},
        {"name": "ActorRolesJson", "type": "Note", "required": true, "format": "JSON array<string>", "updates": "never"},
        {"name": "EventTimestamp", "type": "DateTime", "required": true, "indexed": true, "updates": "never"},
        {"name": "BeforeHash", "type": "Text", "maxLength": 64, "updates": "never"},
        {"name": "AfterHash", "type": "Text", "maxLength": 64, "updates": "never"},
        {"name": "CorrelationId", "type": "Text", "required": true, "indexed": true, "updates": "never"},
        {"name": "DetailsJson", "type": "Note", "format": "JSON object", "updates": "never"}
      ],
      "validation": "Append only. No UI edit or delete permission. Retention and legal-hold policy must be confirmed before production."
    }
  ]
}
